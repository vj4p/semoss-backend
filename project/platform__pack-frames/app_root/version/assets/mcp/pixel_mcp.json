            "description": "New header names for a file",
            "title": "newHeaders",
            "type": "string"
          },
          "space": {
            "description": "This is an optional field to determine the space in which the relative file path exists. When this parameter is not provided, the space is assumed to be the current insight (when the insight is attached to a room it will be the room space). If an UUID is provided, it will be treated as a project id and use the project's directory structure. If the key \"user\" is provided it will be the logged in user's space.",
            "title": "space",
            "type": "string"
